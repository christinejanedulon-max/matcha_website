{% extends 'base.html.twig' %}

{% block title %}Matcha Moments Café — Pure Matcha, Pure Moments{% endblock %}
{% block meta_description %}Handcrafted ceremonial matcha drinks made with premium Japanese ingredients. Order Tropical Matcha, Matcha Latte, Matcha Cloud and more. Pickup or delivery available.{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <style>
        /* =====================================================
           HOMEPAGE MODERN EDITORIAL REDESIGN
           Palette: #2E5227, #4C6B46, #FFFFFF, #E8F1E6, #55744F, #7D9778, #A4B9A1, #D2DCD0
           ===================================================== */
        .hero-landscape-section {
            min-height: 85vh;
            width: 100%;
            position: relative;
            display: flex;
            align-items: center;
            background: #1B3518 url("{{ asset('images/hero.jpg') }}") center right / cover no-repeat;
            overflow: hidden;
            padding: clamp(5.5rem, 9vw, 7.5rem) 0 clamp(3.5rem, 5vw, 4.5rem);
        }
        .hero-landscape-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                rgba(46, 82, 39, 0.96) 0%,
                rgba(46, 82, 39, 0.90) 45%,
                rgba(46, 82, 39, 0.65) 75%,
                rgba(46, 82, 39, 0.40) 100%
            );
            z-index: 1;
        }
        /* 3D Interactive Matcha Particles Canvas */
        .hero-matcha-particles {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 2;
        }
        .hero-container {
            position: relative;
            z-index: 3;
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 clamp(1rem, 4vw, 2.5rem);
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 3rem;
            align-items: center;
            width: 100%;
        }
        .hero-floating-content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }
        .hero-floating-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(232, 241, 230, 0.18);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(232, 241, 230, 0.35);
            padding: 0.45rem 1.2rem;
            border-radius: 50px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #E8F1E6;
            margin-bottom: 1.2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }
        .hero-pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #7D9778;
            box-shadow: 0 0 10px #A4B9A1;
        }
        .hero-floating-title {
            font-family: var(--font-heading);
            font-size: clamp(2.4rem, 5.2vw, 3.8rem);
            font-weight: 800;
            line-height: 1.12;
            letter-spacing: -0.02em;
            color: #FFFFFF;
            margin-bottom: 1rem;
            text-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        .hero-floating-title span {
            color: #E8F1E6;
            position: relative;
            display: inline-block;
        }
        .hero-floating-sub {
            font-size: clamp(0.95rem, 1.8vw, 1.08rem);
            color: rgba(232, 241, 230, 0.92);
            line-height: 1.68;
            max-width: 520px;
            margin-bottom: 1.8rem;
        }
        .hero-floating-badges {
            display: flex;
            gap: 0.8rem;
            margin-bottom: 2.2rem;
            flex-wrap: wrap;
        }
        .hero-mini-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            background: rgba(232, 241, 230, 0.12);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(232, 241, 230, 0.25);
            padding: 0.4rem 0.95rem;
            border-radius: 50px;
            font-size: 0.78rem;
            color: #FFFFFF;
            font-weight: 600;
        }
        .hero-actions-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .btn-hero-deep {
            background: #FFFFFF;
            color: #2E5227;
            font-weight: 700;
            font-size: 0.88rem;
            letter-spacing: 0.04em;
            padding: 0.95rem 2.2rem;
            border-radius: 50px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: all var(--trans-fast);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-hero-deep:hover {
            background: #E8F1E6;
            transform: translateY(-3px);
            box-shadow: 0 14px 35px rgba(0, 0, 0, 0.25);
        }
        .btn-hero-glass {
            background: rgba(232, 241, 230, 0.14);
            color: #FFFFFF;
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(232, 241, 230, 0.4);
            font-weight: 600;
            font-size: 0.88rem;
            letter-spacing: 0.04em;
            padding: 0.95rem 2.2rem;
            border-radius: 50px;
            transition: all var(--trans-fast);
            cursor: pointer;
        }
        .btn-hero-glass:hover {
            background: rgba(232, 241, 230, 0.28);
            border-color: #FFFFFF;
            transform: translateY(-2px);
        }

        /* Floating Cup Card on Right */
        .hero-floating-card-wrap {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hero-cup-glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid #D2DCD0;
            border-radius: 28px;
            padding: 2rem;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
            text-align: center;
            max-width: 380px;
            width: 100%;
            position: relative;
        }
        .hero-cup-stage {
            background: #F2F0E9; /* matches the normalized photo backdrop */
            border-radius: 20px;
            aspect-ratio: 4 / 5;
            width: min(100%, 280px);
            margin: 0 auto;
            overflow: hidden;
        }
        .hero-cup-stage img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 45%;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hero-cup-glass-card:hover .hero-cup-stage img {
            transform: scale(1.05);
        }
        .hero-floating-tag-top {
            position: absolute;
            top: -12px;
            right: 20px;
            background: #2E5227;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.35rem 0.9rem;
            border-radius: 50px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
        }
        .hero-floating-tag-bot {
            margin-top: 1.2rem;
            background: #FAFDF9;
            border: 1px solid #D2DCD0;
            border-radius: 16px;
            padding: 0.85rem 1.1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* 4-Pillars Ribbon */
        .features-ribbon {
            background: #FFFFFF;
            border-bottom: 1px solid #D2DCD0;
            box-shadow: 0 4px 20px rgba(46, 82, 39, 0.03);
            position: relative;
            z-index: 10;
        }
        .features-ribbon-inner {
            max-width: var(--container);
            margin: 0 auto;
            padding: 1.8rem clamp(1rem, 4vw, 2rem);
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 1.5rem;
        }
        .ribbon-item {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .ribbon-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #E8F1E6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            color: #2E5227;
            flex-shrink: 0;
            border: 1px solid #D2DCD0;
        }
        .ribbon-text strong {
            display: block;
            font-size: 0.95rem;
            color: #2E5227;
            margin-bottom: 0.15rem;
            font-weight: 700;
        }
        .ribbon-text span {
            font-size: 0.78rem;
            color: #55744F;
        }

        /* Category Filter Chips */
        .home-menu-tabs {
            display: flex;
            justify-content: center;
            gap: 0.6rem;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }
        .home-menu-tab {
            padding: 0.6rem 1.35rem;
            border-radius: 50px;
            border: 1.5px solid #D2DCD0;
            background: #FFFFFF;
            color: #55744F;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
            transition: all var(--trans-fast);
        }
        .home-menu-tab:hover, .home-menu-tab.active {
            background: #2E5227;
            color: #FFFFFF;
            border-color: #2E5227;
            box-shadow: 0 4px 14px rgba(46, 82, 39, 0.2);
        }

        /* Homepage cards share .drink-card / .drink-pedestal-stage from app.css */

        /* 3D Craft Showcase Card */
        .craft-3d-card {
            position: relative;
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(46, 82, 39, 0.16);
            border: 1px solid #D2DCD0;
            background: #FFFFFF;
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
        }
        .craft-3d-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 28px 60px rgba(46, 82, 39, 0.24);
        }
        .craft-3d-card img {
            width: 100%;
            height: auto;
            max-height: 480px;
            object-fit: cover;
            display: block;
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .craft-3d-card:hover img {
            transform: scale(1.04);
        }
        .craft-3d-badge-top {
            position: absolute;
            top: 18px;
            right: 18px;
            background: rgba(46, 82, 39, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            color: #E8F1E6;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.45rem 1rem;
            border-radius: 50px;
            border: 1px solid rgba(232, 241, 230, 0.35);
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            z-index: 2;
        }
        .craft-3d-caption {
            position: absolute;
            bottom: 20px;
            left: 20px;
            right: 20px;
            background: rgba(46, 82, 39, 0.94);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 18px;
            padding: 1.15rem 1.35rem;
            color: #FFFFFF;
            border: 1px solid rgba(232, 241, 230, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            z-index: 2;
        }

        /* 3D Newsletter Section (Stay in the Matcha Loop) */
        .loop-3d-section {
            background: linear-gradient(135deg, #1C3419 0%, #2E5227 50%, #152712 100%);
            color: #FFFFFF;
            padding: clamp(4rem, 7vw, 5.5rem) clamp(1rem, 4vw, 2rem);
            position: relative;
            overflow: hidden;
        }
        .loop-3d-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -20%;
            width: 140%;
            height: 200%;
            background: radial-gradient(circle at 75% 40%, rgba(164, 185, 161, 0.16) 0%, transparent 60%);
            pointer-events: none;
        }
        .loop-3d-container {
            max-width: var(--container);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: clamp(2rem, 5vw, 4rem);
            align-items: center;
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(232, 241, 230, 0.22);
            border-radius: 32px;
            padding: clamp(2rem, 5vw, 3.5rem);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        }
        .loop-vip-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            background: rgba(232, 241, 230, 0.16);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(232, 241, 230, 0.35);
            padding: 0.4rem 1.1rem;
            border-radius: 50px;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #E8F1E6;
            margin-bottom: 1rem;
        }
        .loop-title {
            font-family: var(--font-heading);
            font-size: clamp(2.1rem, 4.5vw, 3.2rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.02em;
            color: #FFFFFF;
            margin: 0 0 0.85rem;
            text-shadow: 0 4px 18px rgba(0,0,0,0.3);
        }
        .loop-subtext {
            color: rgba(232, 241, 230, 0.9);
            font-size: 0.98rem;
            line-height: 1.7;
            margin-bottom: 2rem;
            max-width: 520px;
        }
        .btn-loop-submit {
            background: #FFFFFF;
            color: #2E5227;
            border: none;
            padding: 0.95rem 2rem;
            border-radius: 50px;
            font-weight: 800;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all var(--trans-fast);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-body);
            white-space: nowrap;
        }
        .btn-loop-submit:hover {
            background: #E8F1E6;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
        }
        .loop-perks-row {
            display: flex;
            gap: 0.85rem;
            flex-wrap: wrap;
            margin-top: 1.8rem;
            border-top: 1px solid rgba(232, 241, 230, 0.18);
            padding-top: 1.5rem;
        }
        .loop-perk-item {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(232, 241, 230, 0.1);
            border: 1px solid rgba(232, 241, 230, 0.2);
            padding: 0.45rem 0.95rem;
            border-radius: 50px;
            font-size: 0.78rem;
            color: #E8F1E6;
            font-weight: 600;
        }
        .loop-perk-item i {
            color: #A4B9A1;
            font-size: 0.95rem;
        }
        /* 3D Visual Stage Right */
        .loop-3d-stage-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 1200px;
        }
        .loop-3d-stage {
            position: relative;
            width: 100%;
            max-width: 440px;
            border-radius: 28px;
            overflow: hidden;
            border: 1.5px solid rgba(232, 241, 230, 0.35);
            background: #1B3518;
            box-shadow: 0 35px 80px rgba(0, 0, 0, 0.55), 0 0 40px rgba(164, 185, 161, 0.2);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
        }
        .loop-3d-stage img {
            width: 100%;
            height: auto;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            display: block;
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .loop-3d-stage:hover img {
            transform: scale(1.05);
        }
        .loop-3d-tag-top {
            position: absolute;
            top: 18px;
            right: 18px;
            background: rgba(46, 82, 39, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            color: #FFFFFF;
            font-weight: 800;
            font-size: 0.74rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0.45rem 1rem;
            border-radius: 50px;
            border: 1px solid rgba(232, 241, 230, 0.3);
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            z-index: 3;
        }
        .loop-3d-floating-card {
            position: absolute;
            bottom: 20px;
            left: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 20px;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            box-shadow: 0 16px 36px rgba(0,0,0,0.35);
            border: 1px solid #D2DCD0;
            z-index: 3;
            color: #2E5227;
        }
        .loop-3d-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #2E5227;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            box-shadow: 0 6px 16px rgba(46, 82, 39, 0.3);
        }

        @media (max-width: 950px) {
            .hero-container { grid-template-columns: 1fr; text-align: center; }
            .hero-floating-content { align-items: center; }
            .hero-actions-group { justify-content: center; }
            .hero-floating-badges { justify-content: center; }
            .hero-floating-card-wrap { display: none; }
            .why-us-inner { grid-template-columns: 1fr !important; }
            .loop-3d-container {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 2rem 1.5rem;
            }
            .loop-subtext { margin: 0 auto 1.8rem; }
            .loop-perks-row { justify-content: center; }
            .loop-3d-stage-wrapper { margin-top: 1.5rem; }
        }
    </style>
{% endblock %}

{% block body %}

{# ==================== 1. HERO SECTION ==================== #}
<section id="home" class="hero-landscape-section">
    <!-- 3D Interactive Matcha Particles Canvas -->
    <canvas id="matchaParticlesCanvas" class="hero-matcha-particles" aria-hidden="true"></canvas>

    <div class="hero-container">

        <!-- Left: Modern Typography & CTAs -->
        <div class="hero-floating-content">
            <div class="hero-floating-pill">
                <span class="hero-pulse-dot"></span>
                <span style="display: inline-flex; align-items: center; gap: 0.45rem;"><i class="bi bi-flower1" style="color: #A4B9A1;"></i> Authentic Japanese Green Tea Experience</span>
            </div>

            <h1 class="hero-floating-title">
                Pure Matcha,<br>
                <span>Pure Moments.</span>
            </h1>

            <p class="hero-floating-sub">
                Directly shade-grown in the misty hills of Uji, Kyoto. Slow stone-ground and whisked fresh per cup with a traditional bamboo chasen for an ultra-smooth velvety froth and serene, lasting energy.
            </p>

            <div class="hero-floating-badges">
                <div class="hero-mini-badge">
                    <i class="bi bi-patch-check-fill" style="color: #A4B9A1;"></i> 100% Ceremonial Tencha
                </div>
                <div class="hero-mini-badge">
                    <i class="bi bi-cup-hot-fill" style="color: #A4B9A1;"></i> Whisked Fresh at 80°C
                </div>
                <div class="hero-mini-badge">
                    <i class="bi bi-lightning-charge-fill" style="color: #A4B9A1;"></i> Calm L-Theanine Energy
                </div>
            </div>

            <div class="hero-actions-group">
                <a href="#menu-showcase" class="btn-hero-deep">
                    <span>Explore Featured Drinks</span> &darr;
                </a>
                <a href="{{ path('app_about') }}" class="btn-hero-glass" style="text-decoration: none; display: inline-flex; align-items: center;">
                    <span>Our Sourcing Story</span> &rarr;
                </a>
            </div>

            <div style="margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.6rem; background: rgba(232, 241, 230, 0.12); backdrop-filter: blur(8px); border: 1px solid rgba(232, 241, 230, 0.22); padding: 0.35rem 0.95rem; border-radius: 50px;">
                <span style="color: #A4B9A1; font-size: 0.88rem;">★★★★★</span>
                <span style="font-size: 0.76rem; color: #E8F1E6; font-weight: 600;">Rated 5.0 / 5.0 by 1,200+ Matcha Lovers</span>
            </div>
        </div>

        <!-- Right: Floating Glass Cup Showcase -->
        <div class="hero-floating-card-wrap">
            <div class="hero-cup-glass-card">
                <span class="hero-floating-tag-top">★ Bestseller Favorite</span>

                <div class="hero-cup-stage">
                    <img src="{{ asset('images/drinks/tropical.jpg') }}" alt="Tropical Matcha Signature">
                </div>

                <div class="hero-floating-tag-bot">
                    <div style="text-align: left;">
                        <strong style="color: #2E5227; font-size: 1.05rem; display: block; font-family: var(--font-heading);">Tropical Matcha</strong>
                        <span style="color: #55744F; font-size: 0.75rem;">Ceremonial Uji + Passionfruit notes</span>
                    </div>
                    <div style="text-align: right;">
                        <span style="color: #2E5227; font-weight: 800; font-size: 1.2rem; font-family: var(--font-heading);">₱185</span>
                    </div>
                </div>

                <button type="button"
                        class="btn-hero-deep"
                        style="width: 100%; margin-top: 1rem; padding: 0.75rem; font-size: 0.82rem; justify-content: center; background: #2E5227; color: #FFFFFF;"
                        onclick="openCustomModal({
                            id: 1,
                            name: 'Tropical Matcha',
                            price: '185.00',
                            imageUrl: 'images/drinks/tropical.jpg',
                            category: 'Signature Lattes & Bestsellers',
                            description: 'Refreshing tropical fruit notes infused with ceremonial Japanese matcha.'
                        })">
                    Quick Customize &amp; Order
                </button>
            </div>
        </div>

    </div>
</section>

{# ==================== 2. VALUE PROPOSITION RIBBON ==================== #}
<section class="features-ribbon">
    <div class="features-ribbon-inner">
        <div class="ribbon-item">
            <div class="ribbon-icon"><i class="bi bi-patch-check-fill"></i></div>
            <div class="ribbon-text">
                <strong>100% Ceremonial Grade</strong>
                <span>Directly shade-grown in Uji, Kyoto</span>
            </div>
        </div>

        <div class="ribbon-item">
