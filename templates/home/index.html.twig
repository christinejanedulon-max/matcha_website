{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* =========================================================================
       1. 3D INTERACTIVE MATCHA PARTICLES ENGINE (HERO CANVAS)
       - Ethereal floating matcha powder particles, tiny tea leaf flecks & steam
       - Perspective projection with spatial depth Z
       - Interactive mouse deflection & 3D parallax drift
       - Auto-pauses with IntersectionObserver when scrolled out of view
       ========================================================================= */
    const canvas = document.getElementById('matchaParticlesCanvas');
    const heroSection = document.getElementById('home');

    if (canvas && heroSection) {
        const ctx = canvas.getContext('2d');
        let width = 0;
        let height = 0;
        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        let animationId = null;
        let isVisible = true;

        // Mouse tracking with smooth interpolation
        const mouse = {
            x: -1000,
            y: -1000,
            targetX: -1000,
            targetY: -1000,
            active: false
        };

        function resizeCanvas() {
            const rect = heroSection.getBoundingClientRect();
            width = rect.width;
            height = rect.height;
            canvas.width = Math.floor(width * dpr);
            canvas.height = Math.floor(height * dpr);
            canvas.style.width = width + 'px';
            canvas.style.height = height + 'px';
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
        }

        resizeCanvas();
        window.addEventListener('resize', resizeCanvas, { passive: true });

        // Particle count tuned for buttery 60fps
        const PARTICLE_COUNT = width < 600 ? 28 : 50;

        class MatchaParticle {
            constructor(initRandomY = false) {
                this.reset(initRandomY);
            }

            reset(randomY = false) {
                this.x = Math.random() * width;
                this.y = randomY ? Math.random() * height : height + 15 + Math.random() * 30;
                // 3D Depth Z: 0.5 (far) to 2.2 (close to camera)
                this.z = 0.5 + Math.random() * 1.7;
                
                // Base upward drift scaled by perspective
                this.vy = -(0.35 + (0.45 / this.z));
                this.baseVx = (Math.random() - 0.5) * 0.25;
                this.phase = Math.random() * Math.PI * 2;
                this.swaySpeed = 0.0012 + Math.random() * 0.0015;
                this.swayAmp = 0.4 + Math.random() * 0.6;

                // Mouse deflection velocity
                this.deflectX = 0;
                this.deflectY = 0;

                // Particle type: 'powder' (65%), 'leaf' (25%), 'steam' (10%)
                const randType = Math.random();
                if (randType < 0.65) {
                    this.type = 'powder';
                    this.radius = (1.5 + Math.random() * 2.8) * this.z;
                    this.alpha = 0.35 + Math.random() * 0.45;
                } else if (randType < 0.90) {
                    this.type = 'leaf';
                    this.size = (3 + Math.random() * 4.5) * this.z;
                    this.alpha = 0.4 + Math.random() * 0.4;
                    // 3D Rotation angles & speeds
                    this.rotX = Math.random() * Math.PI * 2;
                    this.rotY = Math.random() * Math.PI * 2;
                    this.rotZ = Math.random() * Math.PI * 2;
                    this.vRotX = (Math.random() - 0.5) * 0.03;
                    this.vRotY = (Math.random() - 0.5) * 0.03;
                    this.vRotZ = (Math.random() - 0.5) * 0.02;
                } else {
                    this.type = 'steam';
                    this.radius = (12 + Math.random() * 18) * this.z;
                    this.alpha = 0.08 + Math.random() * 0.12;
                }
            }

            update(time) {
                // Interactive mouse repulsion
                if (mouse.active) {
                    const dx = this.x - mouse.x;
                    const dy = this.y - mouse.y;
                    const dist = Math.hypot(dx, dy);
                    const reach = 110 * this.z;
                    if (dist < reach && dist > 1) {
                        const force = (reach - dist) / reach;
                        this.deflectX += (dx / dist) * force * 1.8;
                        this.deflectY += (dy / dist) * force * 1.8;
                    }
                }

                // Dampen mouse deflection smoothly
                this.deflectX *= 0.92;
                this.deflectY *= 0.92;

                // Organic upward convection & wind sway
                const sway = Math.sin(time * this.swaySpeed + this.phase) * this.swayAmp;
                this.x += (this.baseVx + sway) * this.z + this.deflectX;
                this.y += this.vy * this.z + this.deflectY;

                // 3D Rotations for leaves
                if (this.type === 'leaf') {
                    this.rotX += this.vRotX;
                    this.rotY += this.vRotY;
                    this.rotZ += this.vRotZ;
                }

                // Recycle particle once it floats past the top or sides
                if (this.y < -30 || this.x < -40 || this.x > width + 40) {
                    this.reset(false);
                }
            }

            draw() {
                ctx.save();

                if (this.type === 'powder') {
                    // Soft glowing spherical matcha particle
                    const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
                    grad.addColorStop(0, `rgba(232, 241, 230, ${this.alpha})`);
                    grad.addColorStop(0.45, `rgba(164, 185, 161, ${this.alpha * 0.75})`);
                    grad.addColorStop(1, 'rgba(46, 82, 39, 0)');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fill();
                } else if (this.type === 'leaf') {
                    // 3D tumbling matcha tea leaf flake
                    ctx.translate(this.x, this.y);
                    ctx.rotate(this.rotZ);
                    // 3D perspective foreshortening via cos(rotX), cos(rotY)
                    const scaleX = Math.max(0.15, Math.abs(Math.cos(this.rotX)));
                    const scaleY = Math.max(0.15, Math.abs(Math.cos(this.rotY)));
                    ctx.scale(scaleX, scaleY);

                    ctx.fillStyle = `rgba(125, 151, 120, ${this.alpha})`;
                    ctx.beginPath();
                    ctx.moveTo(0, -this.size);
                    ctx.bezierCurveTo(this.size * 0.7, -this.size * 0.3, this.size * 0.7, this.size * 0.5, 0, this.size);
                    ctx.bezierCurveTo(-this.size * 0.7, this.size * 0.5, -this.size * 0.7, -this.size * 0.3, 0, -this.size);
                    ctx.fill();
                } else if (this.type === 'steam') {
                    // Soft luminescent matcha aroma cloud puff
                    const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
                    grad.addColorStop(0, `rgba(232, 241, 230, ${this.alpha})`);
                    grad.addColorStop(0.5, `rgba(164, 185, 161, ${this.alpha * 0.4})`);
                    grad.addColorStop(1, 'rgba(46, 82, 39, 0)');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fill();
                }

                ctx.restore();
            }
        }

        // Initialize particles
        const particles = [];
        for (let i = 0; i < PARTICLE_COUNT; i++) {
            particles.push(new MatchaParticle(true));
        }

        // Mouse listeners
        heroSection.addEventListener('mousemove', function (e) {
            const rect = heroSection.getBoundingClientRect();
            mouse.targetX = e.clientX - rect.left;
            mouse.targetY = e.clientY - rect.top;
            mouse.active = true;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', function () {
            mouse.active = false;
        });

        // Main animation loop
        function renderLoop(time) {
            if (!isVisible) return;

            // Smooth mouse interpolation
            if (mouse.active) {
                mouse.x += (mouse.targetX - mouse.x) * 0.15;
                mouse.y += (mouse.targetY - mouse.y) * 0.15;
            }

            ctx.clearRect(0, 0, width, height);

            for (let i = 0; i < particles.length; i++) {
                particles[i].update(time);
                particles[i].draw();
            }

            animationId = requestAnimationFrame(renderLoop);
        }

        // Pause loop when hero is offscreen for optimal battery/performance
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    isVisible = entry.isIntersecting;
                    if (isVisible) {
                        if (!animationId) {
                            animationId = requestAnimationFrame(renderLoop);
                        }
                    } else if (animationId) {
                        cancelAnimationFrame(animationId);
                        animationId = null;
                    }
                });
            }, { threshold: 0.05 });
            observer.observe(heroSection);
        } else {
            animationId = requestAnimationFrame(renderLoop);
        }
    }

    /* =========================================================================
       2. INTERACTIVE 3D MOUSE TILT (NEWSLETTER & CRAFT CARDS)
       ========================================================================= */
    const tiltElements = [
        document.getElementById('loop3dStage'),
        document.getElementById('craft3dCard')
    ].filter(Boolean);

    tiltElements.forEach(el => {
        el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const rotateY = ((x / rect.width) - 0.5) * 10;
            const rotateX = ((0.5 - (y / rect.height))) * 10;
            el.style.transform = `perspective(1000px) translateY(-6px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg)`;
        });

        el.addEventListener('mouseleave', () => {
            el.style.transform = '';
        });
    });

    /* =========================================================================
       3. NEWSLETTER AJAX FORM HANDLER
       ========================================================================= */
    const newsletterForm = document.getElementById('newsletterForm');
    const successMsg = document.getElementById('newsletterSuccessMsg');
    const submitBtn = document.getElementById('newsletterSubmitBtn');

    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const emailInput = document.getElementById('newsletter-email');
            const email = emailInput ? emailInput.value.trim() : '';

            if (!email) return;

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>Subscribing...</span>';
            }

            const formData = new FormData(newsletterForm);

            fetch(newsletterForm.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    newsletterForm.style.display = 'none';
                    if (successMsg) successMsg.style.display = 'flex';
                    if (typeof showToast === 'function') {
                        showToast('Welcome to the Matcha Loop! Voucher sent.');
                    }
                } else {
                    alert(data.message || 'Please enter a valid email address.');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<span>Join VIP Circle</span> &rarr;';
                    }
                }
            })
            .catch(() => {
                // Graceful fallback to regular form submit if fetch fails
                newsletterForm.submit();
            });
        });
    }
});
</script>
{% endblock %}
