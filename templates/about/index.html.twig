{% extends 'base.html.twig' %}

{% block title %}Our Story & Philosophy — Matcha Moments Café{% endblock %}
{% block meta_description %}Matcha Moments Café — ceremonial grade Uji matcha, handcrafted daily. Discover our story, sourcing philosophy, and pillars of excellence.{% endblock %}

{% block body %}

{# ── HERO ── #}
<section style="
    background: linear-gradient(145deg, #2E5227 0%, #1A3216 100%);
    padding: clamp(7rem,12vw,9rem) 1.5rem clamp(4rem,7vw,6rem);
    text-align: center; position: relative; overflow: hidden;">
    <div style="position:absolute;inset:0;
        background: radial-gradient(circle at 15% 50%, rgba(76,107,70,0.4) 0%, transparent 55%),
                    radial-gradient(circle at 85% 20%, rgba(125,151,120,0.25) 0%, transparent 50%);
        pointer-events:none;"></div>
    <div style="position:relative;max-width:720px;margin:0 auto;">
        <span style="display:inline-block;background:rgba(232,241,230,0.15);border:1px solid rgba(232,241,230,0.3);backdrop-filter:blur(10px);padding:0.4rem 1.2rem;border-radius:50px;font-size:0.78rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#E8F1E6;margin-bottom:1.2rem;">
            🍃 Our Journey & Heritage
        </span>
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.8rem,7vw,5rem);font-weight:800;color:#FFFFFF;line-height:1.05;margin:0 0 1.2rem;letter-spacing:-0.03em;">
            THE ART OF<br><span style="color:#A4B9A1;">PURE MATCHA</span>
        </h1>
        <p style="font-size:clamp(1rem,2vw,1.15rem);color:rgba(232,241,230,0.85);line-height:1.7;max-width:580px;margin:0 auto 2.5rem;">
            Founded with a single sacred intention — to bring authentic, mindful Japanese green tea culture to modern café lovers without compromise.
        </p>
        <a href="{{ path('app_menu') }}" style="display:inline-flex;align-items:center;gap:0.6rem;background:#FFFFFF;color:#2E5227;font-weight:700;font-size:0.95rem;padding:0.85rem 2rem;border-radius:50px;text-decoration:none;transition:all 0.2s;">
            Explore Our Menu →
        </a>
    </div>
</section>

{# ── STAT BAR ── #}
<section style="background:#F7FAF6;border-bottom:1px solid #E8F1E6;">
    <div style="max-width:var(--container);margin:0 auto;padding:2rem clamp(1rem,4vw,2rem);display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:0;text-align:center;">
        {% for stat in [
            {num:'100%',label:'Ceremonial Grade'},
            {num:'14+', label:'Handcrafted Recipes'},
            {num:'3',   label:'Exclusive Collections'},
            {num:'∞',   label:'Mindful Moments'}
        ] %}
        <div style="padding:1.5rem 1rem;border-right:1px solid #E8F1E6;">
            <div style="font-family:var(--font-heading);font-size:2.2rem;font-weight:800;color:#2E5227;line-height:1;">{{ stat.num }}</div>
            <div style="font-size:0.8rem;font-weight:600;color:#55744F;text-transform:uppercase;letter-spacing:0.08em;margin-top:0.3rem;">{{ stat.label }}</div>
        </div>
        {% endfor %}
    </div>
</section>

{# ── STORY SECTION 1 ── #}
<section style="background:#FFFFFF;padding:clamp(4rem,8vw,6rem) 1.5rem;">
    <div style="max-width:var(--container);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:4rem;align-items:center;">
        <div>
            <span style="font-size:0.75rem;font-weight:700;color:#4C6B46;text-transform:uppercase;letter-spacing:0.12em;">Direct Farm Sourcing</span>
            <h2 style="font-family:var(--font-heading);font-size:clamp(2rem,4vw,2.8rem);color:#2E5227;margin:0.6rem 0 1.2rem;line-height:1.15;font-weight:800;">
                100% Ceremonial Grade<br>Sourced from Uji, Japan
            </h2>
            <p style="color:#4C6B46;line-height:1.85;margin-bottom:1.2rem;font-size:1.02rem;">
                Our <em>tencha</em> tea leaves are shade-grown under bamboo reed screens for weeks before harvesting in the misty hills of Uji, Kyoto. This ancient shading technique concentrates natural chlorophyll and L-theanine, yielding that signature emerald color, rich umami depth, and calm sustained alertness.
            </p>
            <p style="color:#7D9778;line-height:1.8;font-size:0.95rem;">
                Each batch is slow stone-ground into an ultra-fine powder that dissolves into silky, fragrant froth with zero artificial additives.
            </p>
            <div style="display:flex;gap:1rem;margin-top:2rem;flex-wrap:wrap;">
                <div style="background:#E8F1E6;border-radius:14px;padding:1rem 1.4rem;text-align:center;min-width:120px;">
                    <div style="font-size:1.5rem;">🌱</div>
                    <div style="font-size:0.78rem;font-weight:700;color:#2E5227;margin-top:0.3rem;">Shade Grown</div>
                </div>
                <div style="background:#E8F1E6;border-radius:14px;padding:1rem 1.4rem;text-align:center;min-width:120px;">
                    <div style="font-size:1.5rem;">🏯</div>
                    <div style="font-size:0.78rem;font-weight:700;color:#2E5227;margin-top:0.3rem;">Uji, Kyoto</div>
                </div>
                <div style="background:#E8F1E6;border-radius:14px;padding:1rem 1.4rem;text-align:center;min-width:120px;">
                    <div style="font-size:1.5rem;">⚗️</div>
                    <div style="font-size:0.78rem;font-weight:700;color:#2E5227;margin-top:0.3rem;">Stone Ground</div>
                </div>
            </div>
        </div>
        <div style="border-radius:28px;overflow:hidden;box-shadow:0 24px 60px rgba(46,82,39,0.14);position:relative;">
            <div style="background:linear-gradient(135deg,#E8F1E6,#D2DCD0);padding:2rem;border-radius:28px;text-align:center;">
                <img src="{{ asset('images/bowl.png') }}" alt="Matcha Bowl and Bamboo Whisk"
                     style="width:100%;max-height:380px;object-fit:contain;filter:drop-shadow(0 16px 30px rgba(46,82,39,0.2));">
            </div>
        </div>
    </div>
</section>

{# ── STORY SECTION 2 ── #}
<section style="background:#F7FAF6;padding:clamp(4rem,8vw,6rem) 1.5rem;">
    <div style="max-width:var(--container);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:4rem;align-items:center;">
        <div style="border-radius:28px;overflow:hidden;box-shadow:0 24px 60px rgba(46,82,39,0.14);">
            <div style="background:linear-gradient(135deg,#D2DCD0,#E8F1E6);padding:2rem;text-align:center;">
                <img src="{{ asset('images/whisk.png') }}" alt="Bamboo Chasen Whisking"
                     style="width:100%;max-height:380px;object-fit:contain;filter:drop-shadow(0 16px 30px rgba(46,82,39,0.2));">
            </div>
        </div>
        <div>
            <span style="font-size:0.75rem;font-weight:700;color:#4C6B46;text-transform:uppercase;letter-spacing:0.12em;">Tradition Meets Innovation</span>
            <h2 style="font-family:var(--font-heading);font-size:clamp(2rem,4vw,2.8rem);color:#2E5227;margin:0.6rem 0 1.2rem;line-height:1.15;font-weight:800;">
                Handcrafted Fresh Daily<br>with Bamboo Chasen
            </h2>
            <p style="color:#4C6B46;line-height:1.85;margin-bottom:1.2rem;font-size:1.02rem;">
                We never use pre-mixed powders or industrial dispensers. Every drink is freshly whisked to order using an authentic bamboo <em>chasen</em> at 80°C spring water — coaxing out gentle floral aromatics without bitter astringency.
            </p>
            <p style="color:#7D9778;line-height:1.8;font-size:0.95rem;">
                Whether paired with creamy oat milk, decadent ube, tropical fruit purees, or our signature sea salt cloud foam — every sip is balanced to perfection.
            </p>
        </div>
    </div>
</section>

{# ── PILLARS OF EXCELLENCE ── #}
<section style="background:#2E5227;padding:clamp(4rem,8vw,6rem) 1.5rem;">
    <div style="max-width:var(--container);margin:0 auto;">
        <div style="text-align:center;margin-bottom:3rem;">
            <span style="font-size:0.78rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#A4B9A1;">What We Stand For</span>
            <h2 style="font-family:var(--font-heading);font-size:clamp(2.2rem,5vw,3.2rem);color:#FFFFFF;margin:0.5rem 0 0;font-weight:800;">OUR PILLARS OF EXCELLENCE</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;">
            {% for pillar in [
                {icon:'🍃', title:'Purity First',       desc:'No artificial colorings, sweeteners, or fillers. Just authentic ceremonial-grade tea.'},
                {icon:'⚡', title:'Clean Energy',       desc:'High in L-theanine for jitter-free, serene focus and all-day calm vitality.'},
                {icon:'✨', title:'Artisan Fusions',    desc:'Beloved local flavors like Philippine Ube and Mango blended with Japanese tea.'},
                {icon:'💚', title:'Community Love',     desc:'Crafting warm memories and comforting moments for every guest who visits.'}
            ] %}
            <div style="background:rgba(255,255,255,0.08);border:1px solid rgba(232,241,230,0.2);border-radius:22px;padding:2rem;text-align:center;backdrop-filter:blur(10px);">
                <div style="font-size:2.5rem;margin-bottom:0.8rem;">{{ pillar.icon }}</div>
                <h3 style="font-family:var(--font-heading);font-size:1.2rem;color:#E8F1E6;margin-bottom:0.6rem;font-weight:700;">{{ pillar.title }}</h3>
                <p style="font-size:0.88rem;color:#A4B9A1;line-height:1.6;">{{ pillar.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── DRINK LINEUP BANNER ── #}
<section style="background:#F7FAF6;padding:clamp(3rem,6vw,5rem) 1.5rem;">
    <div style="max-width:var(--container);margin:0 auto;">
        <div style="border-radius:28px;overflow:hidden;box-shadow:0 12px 40px rgba(46,82,39,0.1);">
            <img src="{{ asset('images/col.png') }}" alt="Matcha Moments Drinks Lineup" style="width:100%;display:block;object-fit:cover;max-height:420px;">
        </div>
        <div style="text-align:center;margin-top:3rem;">
            <a href="{{ path('app_menu') }}" class="btn-hero-primary" style="padding:1rem 2.8rem;font-size:1.05rem;">
                Taste the Difference — Explore Menu →
            </a>
        </div>
    </div>
</section>

{% endblock %}
