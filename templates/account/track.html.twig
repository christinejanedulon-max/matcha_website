{% extends 'base.html.twig' %}

{% block title %}Track Order {{ order.orderNumber }} — Matcha Moments Café{% endblock %}
{% block meta_description %}Live status tracking for Matcha Moments order {{ order.orderNumber }}. Preparation and delivery updates.{% endblock %}

{% block stylesheets %}
<style>
    .track-page-wrap {
        padding: clamp(3rem, 6vw, 4.5rem) 0;
        background: #FAFDF9;
        min-height: 70vh;
    }
    .track-card {
        background: #FFFFFF;
        border: 1px solid #D2DCD0;
        border-radius: 24px;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        box-shadow: 0 8px 30px rgba(46, 82, 39, 0.06);
        margin-bottom: 2rem;
    }
    /* Visual Timeline Stepper */
    .timeline-track-wrap {
        position: relative;
        margin: 2.5rem 0 1.5rem;
    }
    .timeline-steps-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        position: relative;
        z-index: 2;
    }
    .timeline-step {
        text-align: center;
        position: relative;
    }
    .timeline-step-icon {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        margin: 0 auto 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        background: #FFFFFF;
        border: 2.5px solid #D2DCD0;
        color: #7D9778;
        transition: all 0.3s ease;
    }
    .timeline-step.completed .timeline-step-icon {
        background: #2E5227;
        border-color: #2E5227;
        color: #FFFFFF;
    }
    .timeline-step.active .timeline-step-icon {
        background: #E8F1E6;
        border-color: #2E5227;
        color: #2E5227;
        box-shadow: 0 0 0 6px rgba(46, 82, 39, 0.16);
        animation: pulseIcon 2s infinite;
    }
    @keyframes pulseIcon {
        0%, 100% { box-shadow: 0 0 0 4px rgba(46,82,39,0.15); }
        50% { box-shadow: 0 0 0 8px rgba(46,82,39,0.28); }
    }
    .timeline-step-title {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: #2E5227;
        margin-bottom: 0.2rem;
    }
    .timeline-step-desc {
        font-size: 0.75rem;
        color: #7D9778;
        line-height: 1.4;
    }
    .timeline-bar-bg {
        position: absolute;
        top: 27px;
        left: 12%;
        right: 12%;
        height: 4px;
        background: #E8F1E6;
        z-index: 1;
    }
    .timeline-bar-fill {
        height: 100%;
        background: #2E5227;
        transition: width 0.4s ease;
    }
    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #E8F1E6;
        color: #2E5227;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.35rem 0.9rem;
        border-radius: 50px;
        border: 1px solid #A4B9A1;
    }
    .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2E5227;
        animation: blinkLive 1.5s infinite;
    }
    @keyframes blinkLive {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
    }
    @media (max-width: 680px) {
        .timeline-steps-grid { grid-template-columns: 1fr; gap: 1.5rem; text-align: left; }
        .timeline-step { display: flex; align-items: flex-start; gap: 1rem; text-align: left; }
        .timeline-step-icon { margin: 0; flex-shrink: 0; }
        .timeline-bar-bg { display: none; }
    }
</style>
{% endblock %}

{% block body %}

{# ── HERO ── #}
<section class="page-hero" style="--hero-img: url('{{ asset('images/about/tea-ceremony.jpg') }}')">
    <div class="container text-center">
        <span class="live-indicator mb-3" style="background: rgba(232,241,230,0.18); color: #E8F1E6; border-color: rgba(232,241,230,0.35);">
            <span class="live-dot" style="background: #A4B9A1;"></span> Live Order Tracking
        </span>
        <h1 class="page-hero-title">ORDER {{ order.orderNumber }}</h1>
        <p class="page-hero-subtitle">
            Placed on {{ order.orderDate|date('F d, Y • h:i A') }} • {{ order.fulfillmentMethod }}
        </p>
    </div>
</section>

{# ── CONTENT ── #}
<div class="track-page-wrap">
    <div class="container" style="max-width: 860px;">

        <div class="mb-3 d-flex align-items-center justify-content-between">
            <a href="{{ path('app_account_orders') }}" style="font-weight: 700; color: #2E5227; text-decoration: none; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 0.4rem;">
                <i class="bi bi-arrow-left"></i> Back to All Orders
            </a>
            <span class="live-indicator" id="livePollBadge">
                <span class="live-dot"></span> Live Sync Active
            </span>
        </div>

        {# ── MAIN STATUS CARD ── #}
        <div class="track-card">

            {% if isCancelled %}
                <div class="p-4 text-center rounded-4" style="background: #FDE8E8; border: 1.5px solid #F8B4B4;">
                    <div style="font-size: 2.4rem; color: #8E3030; margin-bottom: 0.5rem;">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 800; color: #8E3030; margin-bottom: 0.3rem;">
                        Order Cancelled
                    </h3>
                    <p style="color: #6B2323; font-size: 0.9rem; margin: 0;">
                        This order has been cancelled. For refunds or assistance, please contact customer care at <strong>09653994962</strong>.
                    </p>
                </div>
            {% else %}
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-3 border-bottom" style="border-color: #E8F1E6 !important;">
                    <div>
                        <span style="font-size: 0.75rem; text-transform: uppercase; color: #7D9778; font-weight: 700; letter-spacing: 0.08em;">
                            Current Progress
                        </span>
                        <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: #2E5227; margin: 0.2rem 0 0;" id="liveStatusTitle">
                            {{ steps[currentStepIndex].title|default(order.status) }}
                        </h2>
                    </div>
                    <div class="text-end">
                        <span style="font-size: 0.75rem; color: #7D9778; display: block;">Last status update</span>
                        <strong style="color: #2E5227; font-size: 0.88rem;" id="liveStatusTime">
                            {{ order.statusUpdatedAt|date('h:i:s A') }}
                        </strong>
                    </div>
                </div>

                {# Visual Stepper #}
                <div class="timeline-track-wrap">
                    {% set fillPct = (currentStepIndex >= 0) ? ((currentStepIndex / 3) * 100)|round : 0 %}
                    <div class="timeline-bar-bg">
                        <div class="timeline-bar-fill" id="timelineBarFill" style="width: {{ fillPct }}%;"></div>
                    </div>

                    <div class="timeline-steps-grid">
                        {% for idx, step in steps %}
                            {% set isCompleted = (currentStepIndex > idx) %}
                            {% set isActive = (currentStepIndex == idx) %}
                            <div class="timeline-step {% if isCompleted %}completed{% elseif isActive %}active{% endif %}" id="timelineStep-{{ idx }}">
                                <div class="timeline-step-icon">
                                    {% if isCompleted %}
                                        <i class="bi bi-check-lg"></i>
                                    {% else %}
                                        <i class="bi {{ step.icon }}"></i>
                                    {% endif %}
                                </div>
                                <div class="timeline-step-title">{{ step.title }}</div>
                                <div class="timeline-step-desc">{{ step.desc }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </div>

        {# ── ORDER DETAILS CARD ── #}
        <div class="track-card">
            <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; color: #2E5227; margin-bottom: 1.2rem;">
                <i class="bi bi-bag-check me-2"></i> Order Details &amp; Summary
            </h3>

            {# Items Table #}
            <div class="table-responsive">
                <table class="table" style="vertical-align: middle;">
                    <thead>
                        <tr style="border-bottom: 2px solid #E8F1E6; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: #7D9778;">
                            <th>Item</th>
                            <th>Options</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in order.items %}
                        <tr style="border-bottom: 1px solid #E8F1E6;">
                            <td>
                                <strong style="color: #2E5227; font-size: 0.95rem;">{{ item.name }}</strong>
                            </td>
                            <td>
                                <span style="font-size: 0.8rem; color: #55744F; background: #F7FAF6; padding: 0.2rem 0.6rem; border-radius: 6px; border: 1px solid #E8F1E6;">
                                    {{ item.options|default('Regular') }}
                                </span>
                            </td>
                            <td class="text-center" style="font-weight: 700; color: #2E5227;">
                                {{ item.quantity }}
                            </td>
                            <td class="text-end" style="font-weight: 800; color: #2E5227;">
                                ₱{{ (item.unitPrice * item.quantity)|number_format(2) }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Delivery / Fulfillment Info #}
            <div class="row g-3 mt-3 pt-3 border-top" style="border-color: #E8F1E6 !important;">
                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: #F7FAF6; border: 1px solid #E8F1E6;">
                        <span style="font-size: 0.75rem; text-transform: uppercase; color: #7D9778; font-weight: 700;">
                            Fulfillment Method
                        </span>
                        <div style="font-size: 1rem; font-weight: 800; color: #2E5227; margin-top: 0.2rem;">
                            <i class="bi {% if order.fulfillmentMethod == 'Delivery' %}bi-truck{% else %}bi-shop{% endif %} me-1"></i>
                            {{ order.fulfillmentMethod }}
                        </div>
                        {% if order.fulfillmentMethod == 'Delivery' and order.deliveryAddress %}
                            <div style="font-size: 0.82rem; color: #55744F; margin-top: 0.35rem;">
                                <i class="bi bi-geo-alt me-1"></i> {{ order.deliveryAddress }}
                            </div>
                        {% else %}
                            <div style="font-size: 0.82rem; color: #55744F; margin-top: 0.35rem;">
                                In-store pickup at Matcha Moments Café counter
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded-3" style="background: #F7FAF6; border: 1px solid #E8F1E6;">
                        <span style="font-size: 0.75rem; text-transform: uppercase; color: #7D9778; font-weight: 700;">
                            Payment &amp; Customer
                        </span>
                        <div style="font-size: 1rem; font-weight: 800; color: #2E5227; margin-top: 0.2rem;">
                            <i class="bi bi-credit-card me-1"></i> {{ order.paymentMethod }}
                        </div>
                        <div style="font-size: 0.82rem; color: #55744F; margin-top: 0.35rem;">
                            {{ order.customerName }} {% if order.phone %}• {{ order.phone }}{% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Total #}
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" style="border-color: #E8F1E6 !important;">
                <span style="font-size: 0.95rem; font-weight: 700; color: #55744F;">Total Amount:</span>
                <span style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: #2E5227;">
                    ₱{{ order.totalAmount|number_format(2) }}
                </span>
            </div>

        </div>

    </div>
</div>

{# ── LIVE STATUS POLLING SCRIPT ── #}
{% if not isCancelled and currentStepIndex < 3 %}
<script>
(function() {
    const statusUrl = "{{ path('app_account_order_status', {orderNumber: order.orderNumber}) }}";
    let lastStatus = "{{ order.status|lower }}";

    function pollStatus() {
        fetch(statusUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(res => res.json())
            .then(data => {
                if (data && data.status) {
                    const current = data.status.toLowerCase();
                    if (current !== lastStatus) {
                        // Reload to reflect new step and animation
                        window.location.reload();
                    } else if (data.statusUpdatedAt) {
                        const timeEl = document.getElementById('liveStatusTime');
                        if (timeEl) {
                            const d = new Date(data.statusUpdatedAt);
                            if (!isNaN(d.getTime())) {
                                timeEl.innerText = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                            }
                        }
                    }
                }
            })
            .catch(() => {});
    }

    // Poll every 10 seconds
    setInterval(pollStatus, 10000);
})();
</script>
{% endif %}

{% endblock %}
