{% extends 'base.html.twig' %}

{% block title %}My Profile &amp; Security Settings | Matcha Moments{% endblock %}

{% block body %}
<section class="section" style="padding: 4.5rem 0 5.5rem; background: radial-gradient(circle at 50% 10%, #E8F1E6 0%, #FAFDF9 60%);">
    <div class="container" style="max-width: 820px;">
        
        {# Page Title #}
        <div style="text-align: center; margin-bottom: 2.8rem;">
            <span class="sub-badge" style="background: #E8F1E6; color: #2E5227; font-weight: 800; padding: 0.35rem 1rem; border-radius: 50px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;">
                Account Control
            </span>
            <h1 style="font-family: var(--font-heading); font-size: 2.4rem; color: #2E5227; margin: 0.6rem 0 0.4rem; font-weight: 800;">
                My Profile &amp; Security
            </h1>
            <p style="font-size: 0.95rem; color: #55744F; margin: 0;">
                Manage your credentials, account role identity, and password settings.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
            
            {# Identity Overview Card #}
            <div style="background: #FFFFFF; border-radius: 24px; padding: 2rem; border: 1.5px solid #D2DCD0; box-shadow: 0 12px 35px rgba(46, 82, 39, 0.08); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1.2rem;">
                    <div style="width: 64px; height: 64px; border-radius: 50%; background: #2E5227; color: #FFFFFF; font-size: 1.4rem; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 18px rgba(46, 82, 39, 0.25);">
                        {{ user.fullName|split(' ')|map(w => w|first)|join('')|upper|slice(0,2)|default('U') }}
                    </div>
                    <div>
                        <h2 style="font-size: 1.35rem; color: #2E5227; margin: 0 0 0.2rem; font-weight: 800;">
                            {{ user.fullName }}
                        </h2>
                        <div style="font-size: 0.88rem; color: #55744F;">
                            <i class="bi bi-envelope me-1"></i> {{ user.email }}
                        </div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem;">
                    <div>
                        {% if user.role == 'admin' %}
                            <span style="background: #2E5227; color: #FFFFFF; font-size: 0.72rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.06em;">
                                <i class="bi bi-shield-shaded me-1"></i> System Administrator
                            </span>
                        {% elseif user.role == 'staff' %}
                            <span style="background: #4C6B46; color: #FFFFFF; font-size: 0.72rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.06em;">
                                <i class="bi bi-person-badge-fill me-1"></i> Cafe Staff / Barista
                            </span>
                        {% else %}
                            <span style="background: #E8F1E6; color: #2E5227; font-size: 0.72rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.06em;">
                                <i class="bi bi-patch-check-fill me-1"></i> Verified Customer
                            </span>
                        {% endif %}
                    </div>
                    <small style="color: #7D9778; font-size: 0.75rem;">
                        Status: <strong style="color: #2E5227; text-transform: capitalize;">{{ user.status|default('Active') }}</strong>
                    </small>
                </div>
            </div>

            {# Two-Column Form Grid #}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.8rem;">
                
                {# Card 1: Account Information #}
                <div style="background: #FFFFFF; border-radius: 24px; padding: 2rem; border: 1.5px solid #D2DCD0; box-shadow: 0 12px 35px rgba(46, 82, 39, 0.08);">
                    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.2rem;">
                        <div style="width: 36px; height: 36px; border-radius: 10px; background: #E8F1E6; color: #2E5227; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                            <i class="bi bi-person-vcard"></i>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 1.15rem; color: #2E5227; margin: 0; font-weight: 700;">
                            Account Information
                        </h3>
                    </div>

                    <form action="{{ path('app_account_profile') }}" method="POST">
                        <input type="hidden" name="action" value="update_profile">

                        <div class="auth-field" style="margin-bottom: 1.2rem;">
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2E5227; margin-bottom: 0.4rem;">
                                Full Name
                            </label>
                            <input type="text" name="full_name" value="{{ user.fullName }}" class="auth-input" required>
                        </div>

                        <div class="auth-field" style="margin-bottom: 1.2rem;">
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2E5227; margin-bottom: 0.4rem;">
                                Registered Email
                            </label>
                            <input type="email" value="{{ user.email }}" class="auth-input" disabled style="background: #F4F7F3; cursor: not-allowed; opacity: 0.85;">
                            <small style="color: #7D9778; font-size: 0.72rem; display: block; margin-top: 0.3rem;">
                                Email address is your primary account identifier and cannot be changed here.
                            </small>
                        </div>

                        <button type="submit" class="btn-hero-primary" style="width: 100%; border: none; padding: 0.75rem 1.2rem; border-radius: 12px; font-weight: 700; cursor: pointer;">
                            Update Profile Details
                        </button>
                    </form>
                </div>

                {# Card 2: Change Password #}
                <div style="background: #FFFFFF; border-radius: 24px; padding: 2rem; border: 1.5px solid #D2DCD0; box-shadow: 0 12px 35px rgba(46, 82, 39, 0.08);">
                    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.2rem;">
                        <div style="width: 36px; height: 36px; border-radius: 10px; background: #E8F1E6; color: #2E5227; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h3 style="font-family: var(--font-heading); font-size: 1.15rem; color: #2E5227; margin: 0; font-weight: 700;">
                            Change Password
                        </h3>
                    </div>

                    <form action="{{ path('app_account_profile') }}" method="POST">
                        <input type="hidden" name="action" value="change_password">

                        <div class="auth-field" style="margin-bottom: 1rem;">
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2E5227; margin-bottom: 0.4rem;">
                                Current Password *
                            </label>
                            <input type="password" name="current_password" class="auth-input" placeholder="Enter current password" required>
                        </div>

                        <div class="auth-field" style="margin-bottom: 1rem;">
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2E5227; margin-bottom: 0.4rem;">
                                New Password * (min 6 characters)
                            </label>
                            <input type="password" name="new_password" class="auth-input" minlength="6" placeholder="Enter new secure password" required>
                        </div>

                        <div class="auth-field" style="margin-bottom: 1.2rem;">
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2E5227; margin-bottom: 0.4rem;">
                                Confirm New Password *
                            </label>
                            <input type="password" name="confirm_password" class="auth-input" minlength="6" placeholder="Repeat new password" required>
                        </div>

                        <button type="submit" class="btn-hero-primary" style="width: 100%; border: none; padding: 0.75rem 1.2rem; border-radius: 12px; font-weight: 700; cursor: pointer; background: #4C6B46;">
                            Save New Password
                        </button>
                    </form>
                </div>

            </div>

            {# Quick Navigation Shortcuts Based on Role #}
            <div style="text-align: center; margin-top: 1rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
                {% if user.role == 'admin' %}
                    <a href="{{ path('admin_dashboard') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                    </a>
                    <a href="{{ path('admin_users') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-people me-1"></i> User Management
                    </a>
                {% elseif user.role == 'staff' %}
                    <a href="{{ path('staff_dashboard') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-person-badge me-1"></i> Staff Workspace
                    </a>
                    <a href="{{ path('staff_orders') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-receipt me-1"></i> Live Order Queue
                    </a>
                {% else %}
                    <a href="{{ path('app_account_orders') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-clock-history me-1"></i> My Orders &amp; Tracking
                    </a>
                    <a href="{{ path('app_menu') }}" class="btn-hero-secondary" style="text-decoration: none; padding: 0.65rem 1.4rem; border-radius: 50px;">
                        <i class="bi bi-cup-straw me-1"></i> Order Fresh Drinks
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</section>
{% endblock %}
