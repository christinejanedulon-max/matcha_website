{% extends 'base.html.twig' %}

{% block title %}Order Confirmed #{{ order.orderNumber }} — Matcha Moments Café{% endblock %}

{% block body %}
<section style="background:linear-gradient(145deg,#2E5227 0%,#1A3216 60%,#2E5227 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:clamp(6rem,10vw,8rem) 1.5rem 3rem;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 10% 50%, rgba(76,107,70,0.4) 0%, transparent 55%),radial-gradient(circle at 90% 20%, rgba(125,151,120,0.3) 0%, transparent 50%);pointer-events:none;"></div>

    <div style="position:relative;width:100%;max-width:580px;">
        <div style="background:#FFFFFF;border-radius:28px;padding:clamp(2rem,5vw,3rem);box-shadow:0 32px 80px rgba(0,0,0,0.25);">

            {# Success Header #}
            <div style="text-align:center;margin-bottom:2rem;">
                <div style="width:72px;height:72px;border-radius:50%;background:#E8F1E6;display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 1rem;">✅</div>
                <div style="display:inline-block;background:#E8F1E6;color:#2E5227;font-size:0.72rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;padding:0.3rem 1rem;border-radius:50px;margin-bottom:0.8rem;">Order Confirmed</div>
                <h1 style="font-family:var(--font-heading);font-size:clamp(1.8rem,5vw,2.5rem);color:#2E5227;font-weight:800;margin:0 0 0.5rem;letter-spacing:-0.02em;">ORDER PLACED! 🍵</h1>
                <p style="color:#55744F;font-size:0.95rem;">Thank you, <strong style="color:#2E5227;">{{ order.customerName }}</strong>! Your handcrafted matcha is being prepared.</p>
                <div style="display:inline-block;background:#2E5227;color:#FFFFFF;font-weight:800;font-size:0.95rem;padding:0.5rem 1.4rem;border-radius:50px;margin-top:0.8rem;">
                    Order #{{ order.orderNumber }}
                </div>
            </div>

            {# Status Stepper #}
            <div style="background:#F7FAF6;border-radius:18px;padding:1.5rem;margin-bottom:1.8rem;">
                {% set st = order.status|lower %}
                <div style="display:flex;align-items:center;justify-content:space-between;position:relative;">
                    <div style="position:absolute;top:16px;left:0;right:0;height:2px;background:#E8F1E6;z-index:0;"></div>
                    {% for step in [
                        {label:'Placed',   icon:'✓',  done:true},
                        {label:'Preparing',icon:'2',  done: st in ['preparing','ready','completed']},
                        {label:(order.fulfillmentMethod == 'Delivery' ? 'Delivery' : 'Pickup'), icon:'3', done: st in ['ready','completed']},
                        {label:'Done!',    icon:'🎉', done: st == 'completed'}
                    ] %}
                    <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;position:relative;z-index:1;flex:1;">
                        <div style="width:34px;height:34px;border-radius:50%;background:{% if step.done %}#2E5227{% else %}#D2DCD0{% endif %};color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:800;box-shadow:0 3px 10px rgba(46,82,39,0.2);">{{ step.icon }}</div>
                        <span style="font-size:0.72rem;font-weight:700;color:{% if step.done %}#2E5227{% else %}#A4B9A1{% endif %};text-align:center;line-height:1.2;">{{ step.label }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Receipt #}
            <div style="background:#F7FAF6;border-radius:18px;padding:1.5rem;margin-bottom:1.8rem;">
                <div style="display:flex;justify-content:space-between;font-size:0.78rem;color:#7D9778;margin-bottom:1rem;padding-bottom:0.6rem;border-bottom:1px solid #E8F1E6;">
                    <span>{{ order.orderDate|date('M d, Y • h:i A') }}</span>
                    <span style="font-weight:700;color:#2E5227;">{{ order.status|upper }}</span>
                </div>

                {% for item in order.items %}
                <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #F0F7EE;font-size:0.9rem;">
                    <div>
                        <strong style="color:#2E5227;">{{ item.quantity }}× {{ item.name }}</strong>
                        {% if item.options is defined and item.options %}
                            <div style="font-size:0.72rem;color:#A4B9A1;">{{ item.options }}</div>
                        {% endif %}
                    </div>
                    <div style="font-weight:700;color:#2E5227;">₱{{ (item.unitPrice * item.quantity)|number_format(2) }}</div>
                </div>
                {% endfor %}

                <div style="margin-top:0.8rem;padding-top:0.8rem;border-top:2px dashed #D2DCD0;">
                    <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:#55744F;margin-bottom:0.3rem;">
                        <span>Fulfillment ({{ order.fulfillmentMethod }})</span>
                        <span>{% if order.fulfillmentMethod == 'Delivery' %}₱50.00{% else %}Free Pickup{% endif %}</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-family:var(--font-heading);font-size:1.3rem;font-weight:800;color:#2E5227;margin-top:0.5rem;">
                        <span>Total</span>
                        <span>₱{{ order.totalAmount|number_format(2) }}</span>
                    </div>
                </div>
            </div>

            {# Customer details #}
            <div style="background:#E8F1E6;border-radius:14px;padding:1rem 1.2rem;font-size:0.82rem;color:#2E5227;margin-bottom:1.8rem;">
                <p style="margin:0 0 0.3rem;"><strong>📞</strong> {{ order.phone }}</p>
                {% if order.deliveryAddress %}<p style="margin:0 0 0.3rem;"><strong>📍</strong> {{ order.deliveryAddress }}</p>{% endif %}
                <p style="margin:0;"><strong>💳</strong> {{ order.paymentMethod }}{% if order.referenceNumber %} (Ref: {{ order.referenceNumber }}){% endif %}</p>
                {% if order.notes is defined and order.notes %}<p style="margin:0.3rem 0 0;"><strong>📝</strong> {{ order.notes }}</p>{% endif %}
            </div>

            {# CTAs #}
            <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
                <a href="{{ path('app_menu') }}" class="btn-hero-primary" style="padding:0.8rem 2rem;">Order More →</a>
                <a href="{{ path('admin_orders') }}" style="display:inline-flex;align-items:center;padding:0.8rem 2rem;border-radius:50px;border:2px solid #2E5227;color:#2E5227;font-weight:700;font-size:0.9rem;text-decoration:none;">Admin View</a>
            </div>

        </div>
    </div>
</section>
{% endblock %}
